{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gesturekit.local/schemas/provider-v2.schema.json",
  "title": "GestureKit Provider Protocol v2 Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "messageId", "providerSessionId", "type", "timestamp", "payload", "error"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "messageId": { "$ref": "#/$defs/nonEmptyString" },
    "providerSessionId": { "$ref": "#/$defs/nonEmptyString" },
    "gestureSessionId": { "type": ["string", "null"] },
    "operationId": { "type": ["string", "null"] },
    "type": { "enum": ["provider_hello", "provider_challenge", "provider_authenticate", "capability_snapshot", "context_request", "context_snapshot", "configuration_snapshot", "configuration_ack", "action_request", "action_accepted", "action_result", "telemetry_batch", "telemetry_ack", "health_probe", "health_response", "operation_status_request", "operation_status_response", "control_center_open_request", "control_center_open_response"] },
    "timestamp": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" },
    "error": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "provider_hello" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/hello" } } } },
    { "if": { "properties": { "type": { "const": "provider_challenge" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/challenge" } } } },
    { "if": { "properties": { "type": { "const": "provider_authenticate" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/authenticate" } } } },
    { "if": { "properties": { "type": { "const": "capability_snapshot" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/capability" } } } },
    { "if": { "properties": { "type": { "const": "context_request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/contextRequest" } } } },
    { "if": { "properties": { "type": { "const": "context_snapshot" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/contextSnapshot" } } } },
    { "if": { "properties": { "type": { "const": "configuration_snapshot" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/configurationSnapshot" } } } },
    { "if": { "properties": { "type": { "const": "configuration_ack" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/configurationAck" } } } },
    { "if": { "properties": { "type": { "const": "action_request" } } }, "then": { "required": ["operationId"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" }, "payload": { "$ref": "#/$defs/actionRequest" } } } },
    { "if": { "properties": { "type": { "const": "action_accepted" } } }, "then": { "required": ["operationId"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" }, "payload": { "$ref": "#/$defs/actionAccepted" } } } },
    { "if": { "properties": { "type": { "const": "action_result" } } }, "then": { "required": ["operationId"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" }, "payload": { "$ref": "#/$defs/actionResult" } } } },
    { "if": { "properties": { "type": { "const": "telemetry_batch" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/telemetryBatch" } } } },
    { "if": { "properties": { "type": { "const": "telemetry_ack" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/telemetryAck" } } } },
    { "if": { "properties": { "type": { "const": "health_probe" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/healthProbe" } } } },
    { "if": { "properties": { "type": { "const": "health_response" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/healthResponse" } } } },
    { "if": { "properties": { "type": { "const": "operation_status_request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/operationStatusRequest" } } } },
    { "if": { "properties": { "type": { "const": "operation_status_response" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/operationStatusResponse" } } } }
    ,{ "if": { "properties": { "type": { "const": "control_center_open_request" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/controlCenterOpenRequest" } } } }
    ,{ "if": { "properties": { "type": { "const": "control_center_open_response" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/controlCenterOpenResponse" } } } }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "$ref": "#/$defs/nonEmptyString" }, "message": { "$ref": "#/$defs/nonEmptyString" } } },
    "hello": { "type": "object", "additionalProperties": false, "required": ["installId", "protocolVersions", "environment"], "properties": { "installId": { "$ref": "#/$defs/nonEmptyString" }, "protocolVersions": { "type": "array", "items": { "type": "integer" } }, "environment": { "$ref": "#/$defs/nonEmptyString" } } },
    "challenge": { "type": "object", "additionalProperties": false, "required": ["nonce", "expiresAt"], "properties": { "nonce": { "$ref": "#/$defs/nonEmptyString" }, "expiresAt": { "type": "integer", "minimum": 0 } } },
    "authenticate": { "type": "object", "additionalProperties": false, "required": ["installId", "hmac"], "properties": { "installId": { "$ref": "#/$defs/nonEmptyString" }, "hmac": { "$ref": "#/$defs/nonEmptyString" } } },
    "capability": { "type": "object", "additionalProperties": false, "required": ["capabilities", "capabilityVersion"], "properties": { "capabilities": { "type": "array", "items": { "$ref": "#/$defs/actionId" } }, "capabilityVersion": { "type": "integer", "minimum": 0 } } },
    "contextRequest": { "type": "object", "additionalProperties": false, "required": ["gestureSessionId", "deadline"], "properties": { "gestureSessionId": { "$ref": "#/$defs/nonEmptyString" }, "deadline": { "type": "integer", "minimum": 0 } } },
    "contextSnapshot": { "type": "object", "additionalProperties": false, "required": ["contextId", "pageIdentity", "expiresAt", "targetKind"], "properties": { "contextId": { "$ref": "#/$defs/nonEmptyString" }, "pageIdentity": { "type": "string" }, "expiresAt": { "type": "integer", "minimum": 0 }, "targetKind": { "enum": ["standard_link", "no_target", "page_unavailable"] }, "targetRef": { "type": ["string", "null"] } } },
    "configurationSnapshot": { "type": "object", "additionalProperties": false, "required": ["storeEpoch", "schemaVersion", "configurationVersion", "configJSON"], "properties": { "storeEpoch": { "$ref": "#/$defs/nonEmptyString" }, "schemaVersion": { "type": "integer", "minimum": 0 }, "configurationVersion": { "type": "integer", "minimum": 0 }, "configJSON": { "type": "string" } } },
    "configurationAck": { "type": "object", "additionalProperties": false, "required": ["appliedVersion", "applied"], "properties": { "appliedVersion": { "type": "integer", "minimum": 0 }, "applied": { "type": "boolean" } } },
    "actionId": { "enum": ["browser.link.open_adjacent", "browser.tab.activate_previous", "browser.tab.activate_next", "browser.tab.close_current", "browser.history.back", "browser.history.forward", "browser.page.reload"] },
    "actionRequest": { "type": "object", "additionalProperties": false, "required": ["actionId", "contextId", "parameters", "deadline"], "properties": { "actionId": { "$ref": "#/$defs/actionId" }, "contextId": { "$ref": "#/$defs/nonEmptyString" }, "targetRef": { "type": ["string", "null"] }, "parameters": { "type": "object", "additionalProperties": { "type": "string" } }, "deadline": { "type": "integer", "minimum": 0 } } },
    "actionAccepted": { "type": "object", "additionalProperties": false, "required": ["operationId", "acceptedAt"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" }, "acceptedAt": { "type": "integer", "minimum": 0 } } },
    "actionResult": { "type": "object", "additionalProperties": false, "required": ["operationId", "outcome", "completedAt"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" }, "outcome": { "enum": ["succeeded", "failed", "result_unknown"] }, "reason": { "type": ["string", "null"] }, "completedAt": { "type": "integer", "minimum": 0 } } },
    "telemetryBatch": { "type": "object", "additionalProperties": false, "required": ["events"], "properties": { "events": { "type": "array", "items": { "type": "object" } } } },
    "telemetryAck": { "type": "object", "additionalProperties": false, "required": ["acknowledgedEventIds"], "properties": { "acknowledgedEventIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } } } },
    "healthProbe": { "type": "object", "additionalProperties": false, "required": ["probeSequence", "sentAt"], "properties": { "probeSequence": { "type": "integer", "minimum": 0 }, "sentAt": { "type": "integer", "minimum": 0 } } },
    "healthResponse": { "type": "object", "additionalProperties": false, "required": ["probeSequence", "healthy"], "properties": { "probeSequence": { "type": "integer", "minimum": 0 }, "healthy": { "type": "boolean" } } },
    "operationStatusRequest": { "type": "object", "additionalProperties": false, "required": ["operationId"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" } } },
    "operationStatusResponse": { "type": "object", "additionalProperties": false, "required": ["operationId", "outcome"], "properties": { "operationId": { "$ref": "#/$defs/nonEmptyString" }, "outcome": { "enum": ["succeeded", "failed", "result_unknown"] } } },
    "controlCenterOpenRequest": { "type": "object", "additionalProperties": false },
    "controlCenterOpenResponse": { "type": "object", "additionalProperties": false, "required": ["opened"], "properties": { "opened": { "type": "boolean" } } }
  }
}
